{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "postgres": ["./node_modules/postgres/types/index.d.ts"] }
  },
  "include": ["src", "drizzle.config.ts", "vitest.config.ts"]
}
