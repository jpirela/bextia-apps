# Copiar a .env (nunca se commitea). Valores reales solo en Render / máquina local.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
ANTHROPIC_API_KEY=
PORT=10000
DEFAULT_MARKET=ES
CORS_ORIGINS=http://localhost:5173
SIMULATOR_ENABLED=true
EMAIL_WEBHOOK_SECRET=
FORM_WEBHOOK_SECRET=
# Firma de los tokens del widget web (mínimo 32 caracteres; obligatoria en producción).
# El origen del widget debe figurar en CORS_ORIGINS.
WIDGET_TOKEN_SECRET=
# Importación de reservas (POST /import/bookings y /import/email).
# ≥ 32 caracteres; vacío desactiva la ruta.
IMPORT_TOKEN=
IMPORT_EMAIL_SECRET=
# WhatsApp Cloud API (Meta): las cuatro o ninguna
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# SMTP personalizado de Supabase (Resend/Brevo): las cinco o ninguna
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Migraciones (conexión de sesión, puerto 5432)
DATABASE_URL_DIRECT=
# Proyecto Supabase (obligatoria, https): JWKS del JWT del backoffice, login y embeddings.
SUPABASE_URL=https://<proyecto>.supabase.co
# Clave publicable (anon / sb_publishable_…) del proyecto. Solo la usa la API para el login del backoffice.
SUPABASE_ANON_KEY=
# Embeddings gte-small (Edge Function `embed`): opcional, requiere SUPABASE_URL
EMBED_SECRET=
# Webhook opcional de entrega de leads: las dos o ninguna
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
BACKOFFICE_URL=
# Reglas de scoring (JSON parcial sobre los valores por defecto), opcional
SCORING_RULES_JSON=
